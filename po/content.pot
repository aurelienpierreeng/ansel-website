msgstr ""

#. type: Plain text
#: content/community/where-may-i-find-darktable-4-0-1-binaries.md:177
#, markdown-text, no-wrap
msgid "sudo flatpak update --commit=ffe32b5c29648562b2c400c4bf3df2832ca165a216ea6292e5a741f7e353955b org.darktable.Darktable\n"
msgstr ""

#. type: Plain text
