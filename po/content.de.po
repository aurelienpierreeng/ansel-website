msgstr ""

#. type: Plain text
#: content/community/where-may-i-find-darktable-4-0-1-binaries.md:157
#, no-wrap
msgid "You can install it using the flatpak command and pointing it to flathub repository.\n"
msgstr ""

#. type: Plain text
#: content/community/where-may-i-find-darktable-4-0-1-binaries.md:159
#, no-wrap
msgid "Flathub does not guarantee storing all versions or the time it would store available ones.\n"
msgstr ""

#. type: Plain text
#: content/community/where-may-i-find-darktable-4-0-1-binaries.md:161
#, no-wrap
msgid "You can list the available versions and the list of commits uploaded to flathub using this command:\n"
msgstr ""

#. type: Plain text
#: content/community/where-may-i-find-darktable-4-0-1-binaries.md:163
#: content/community/where-may-i-find-darktable-4-0-1-binaries.md:167
