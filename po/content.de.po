msgstr ""

#. type: Plain text
#: content/community/whitebalancing-an-astromodified-camera.md:50
#, no-wrap
msgid "\\> did I change that by removing the filter?\n"
msgstr ""

#. type: Plain text
#: content/community/whitebalancing-an-astromodified-camera.md:52
#, no-wrap
msgid "I believe yes.\n"
msgstr ""

#. type: Plain text
#: content/community/whitebalancing-an-astromodified-camera.md:54
