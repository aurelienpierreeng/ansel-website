#: content/community/suppressions-de-fichiers-jpeg-et-raw.md:28
#, markdown-text, no-wrap
msgid "*Posted by **Bild** on 2024-11-01.*\n"
msgstr ""

#. type: Plain text
#: content/community/suppressions-de-fichiers-jpeg-et-raw.md:30
#, markdown-text, no-wrap
msgid "Hello Bonsoir à tous,\n"
msgstr ""

#. type: Plain text
#: content/community/suppressions-de-fichiers-jpeg-et-raw.md:32
#, markdown-text, no-wrap
msgid "J'ai fait du nettoyage dans mes fichier Jpeg et Raw et j'en ai supprimé quelques uns. Aussi depuis, il y a des vignettes \"têtes de mort\" qui apparaissent. Et c'est moche !\n"
msgstr ""

#. type: Plain text
#: content/community/suppressions-de-fichiers-jpeg-et-raw.md:34
#, markdown-text, no-wrap
msgid "Que faut il faire pour faire disparaître ces \"têtes de mort\"?\n"
